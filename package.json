{
  "name": "routinetracker",
  "private": true,
  "version": "1.0.0",
  "description": "App Android que registra automaticamente a chegada e a saída dos seus lugares com geofences, com extrato, gráficos e metas.",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/core/*.test.ts",
    "build": "tsc --noEmit && vite build",
    "sync": "npm run build && cap sync android"
  },
  "dependencies": {
    "@capacitor/android": "8.5.2",
    "@capacitor/app": "8.1.1",
    "@capacitor/core": "8.5.2",
    "@capacitor/filesystem": "8.1.3",
    "@capacitor/geolocation": "8.2.2",
    "@capacitor/share": "8.0.2",
    "@fontsource/plus-jakarta-sans": "5.3.0",
    "@fontsource/space-mono": "5.3.0",
    "leaflet": "1.9.4",
    "lucide-react": "1.48.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.2",
    "@tailwindcss/vite": "4.3.3",
    "@types/leaflet": "1.9.22",
    "@types/node": "^22.14.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "sharp": "0.35.5",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.1"
  }
}
